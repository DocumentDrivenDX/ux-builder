{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-builder.dev/schema/blueprint.schema.json",
  "title": "ux-builder blueprint (CONTRACT-005)",
  "description": "One file per app or view: its kind, the size classes and inputs it supports, its destinations and its screens. Checked by ux-builder-blueprint check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "name",
    "supports",
    "screens"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "app",
        "view"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizeClasses",
        "inputs"
      ],
      "properties": {
        "sizeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "compact",
              "medium",
              "expanded",
              "large",
              "extra-large"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "coarse",
              "fine"
            ]
          }
        },
        "modalities": {
          "description": "The kinds of experience the app gives its users (FEAT-014, ADR-032): responsive-web, chat, hybrid-chat. Without it, the blueprint is read as [\"responsive-web\"]. ios, android, macos and windows are future modalities and are refused.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "responsive-web",
              "chat",
              "hybrid-chat"
            ]
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "screen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "screen": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "description": "The URL path the screen is served at, e.g. /review; the audit matches a page to a screen by data-piq-screen, then by path.",
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          },
          "primaryAction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "destructiveActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "safeguard"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "safeguard": {
                  "enum": [
                    "undo",
                    "confirm",
                    "none"
                  ]
                }
              }
            }
          },
          "states": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "empty",
                "loading",
                "error",
                "partial"
              ]
            }
          },
          "modals": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/modal"
            }
          },
          "ai": {
            "$ref": "#/$defs/ai"
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            }
          },
          "stories": {
            "description": "The HELIX stories this screen serves (US-<n>); with a HELIX marker, each needs a journey (journey.story-covered).",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^US-[0-9]+$"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "description": "What the screen is for, in a sentence (FEAT-018 GDL-32)"
          },
          "content": {
            "type": "array",
            "description": "The information on the screen, highest priority first (FEAT-018 GDL-32)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "description": "For example data, action, help, status"
                }
              }
            }
          },
          "interactionKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The kinds of interaction the screen handles, such as choose-location (FEAT-018 GDL-34)"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "description": "The task model (FEAT-018 GDL-22)"
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journey"
      }
    }
  },
  "if": {
    "required": [
      "kind"
    ],
    "properties": {
      "kind": {
        "const": "app"
      }
    }
  },
  "then": {
    "required": [
      "destinations"
    ]
  },
  "$defs": {
    "modal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "dismiss"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "dialog",
            "sheet"
          ]
        },
        "dismiss": {
          "enum": [
            "cancel",
            "close",
            "done"
          ]
        },
        "editsData": {
          "type": "boolean"
        },
        "guardsUnsavedChanges": {
          "type": "boolean"
        },
        "modals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modal"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "ai": {
      "description": "What AI does on this screen (FEAT-011, CONTRACT-005 AI and agent experience).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "generative",
              "assistant",
              "agent"
            ]
          }
        },
        "acts": {
          "type": "boolean"
        },
        "highImpactActions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "approval": {
                "enum": [
                  "each",
                  "plan",
                  "none"
                ]
              }
            }
          }
        },
        "renders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "region": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "compact",
              "medium",
              "expanded",
              "large",
              "extra-large"
            ]
          }
        },
        "essential": {
          "type": "boolean"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "dataLeavesDevice": {
          "type": "boolean"
        },
        "consent": {
          "type": "string",
          "minLength": 1
        },
        "takeover": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "description": "Something a user does on a screen or modal, and where it leads (FEAT-012, CONTRACT-005 Flows and journeys).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "description": "A screen id, modal:<modal id>, back, state:<state> or external.",
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        },
        "destructive": {
          "enum": [
            "undo",
            "confirm",
            "none"
          ]
        },
        "highImpact": {
          "enum": [
            "each",
            "plan",
            "none"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "empty",
            "loading",
            "error"
          ]
        },
        "expect": {
          "enum": [
            "empty",
            "loading",
            "error"
          ]
        },
        "scenario": {
          "enum": [
            "normal",
            "errorProne",
            "risky"
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the step asks of the user (FEAT-018 GDL-09): information the user must give, and information the system could infer or default",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inferable": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "description": "A choice the user must make at this step (FEAT-018 GDL-09)"
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "description": "Work the app does for the user at this step (FEAT-018 GDL-09)"
        }
      }
    },
    "journey": {
      "description": "A story's path through the flow, with alternates (FEAT-012, CONTRACT-005 Flows and journeys).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "story",
        "entry",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^J-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "story": {
          "type": "string",
          "pattern": "^US-[0-9]+$"
        },
        "criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^US-[0-9]+-AC[0-9]+$"
          }
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "steps"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "enum": [
                  "normal",
                  "errorProne",
                  "risky"
                ]
              }
            }
          }
        },
        "task": {
          "type": "string",
          "pattern": "^T-[1-9][0-9]*$",
          "description": "The task this journey realizes (FEAT-018 GDL-23)"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "goal",
        "success"
      ],
      "description": "Something a user must accomplish (FEAT-018 GDL-22, CONTRACT-008 Amendment to CONTRACT-005)",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[1-9][0-9]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "The outcome the user wants"
        },
        "jobs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^J-[1-9][0-9]*$"
          },
          "description": "The jobs it serves (docs/ux/jobs.md)"
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "description": "What starts it"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Information the user must give, and information they may give or the system can infer or defer"
        },
        "systemActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Work the system does automatically"
        },
        "userActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Interactions the user must perform"
        },
        "success": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^US-[0-9]+-AC[0-9]+$"
          },
          "description": "The observable completion condition, as acceptance criteria"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Error and recovery scenarios"
        },
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal"
            ],
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "ways": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "interactionKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Kinds of interaction it needs, such as choose-location (FEAT-018 GDL-34)"
        }
      }
    }
  }
}
