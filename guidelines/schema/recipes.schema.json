{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipes.schema.json",
  "title": "ux-builder recipes (CONTRACT-005)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recipes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "job",
          "keywords",
          "kind",
          "screens",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "job": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "enum": [
              "app",
              "view",
              "any"
            ]
          },
          "screens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pattern",
                "role"
              ],
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
