{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentdrivendx.github.io/ux-builder/schema/rubric.schema.json",
  "title": "UX quality rubric (CONTRACT-008 Rubric)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "dimensions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "question",
          "measures",
          "baseline",
          "sources"
        ],
        "properties": {
          "id": {
            "enum": [
              "task-effectiveness",
              "task-efficiency",
              "cognitive-load",
              "discoverability",
              "learnability",
              "consistency",
              "accessibility",
              "error-recovery",
              "user-confidence"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "measures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "baseline": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url",
                "licence",
                "wording"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "licence": {
                  "enum": [
                    "nngroup-terms",
                    "W3C",
                    "own",
                    "CC-BY-4.0"
                  ]
                },
                "wording": {
                  "const": "paraphrased"
                }
              }
            }
          }
        }
      }
    }
  }
}
