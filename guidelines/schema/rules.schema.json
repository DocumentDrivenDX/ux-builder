{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "ux-builder interaction rules (CONTRACT-005)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compactDestinations",
        "lineLength"
      ],
      "properties": {
        "compactDestinations": {
          "type": "integer",
          "minimum": 1
        },
        "lineLength": {
          "type": "integer",
          "minimum": 20
        }
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "protects",
          "ruleOfThumb"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/priority"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "protects": {
            "type": "string",
            "minLength": 1
          },
          "ruleOfThumb": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clashOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "rationale",
        "checks",
        "severity",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "context": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "app",
                  "view"
                ]
              }
            },
            "sizeClass": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "compact",
                  "medium",
                  "expanded",
                  "large",
                  "extra-large"
                ]
              }
            },
            "input": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "coarse",
                  "fine"
                ]
              }
            },
            "aiRole": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "generative",
                  "assistant",
                  "agent"
                ]
              }
            },
            "modality": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "responsive-web",
                  "chat",
                  "hybrid-chat"
                ]
              }
            }
          }
        },
        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "widgets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Where the rule applies, in words, when when and appliesTo cannot say it"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "blueprint",
                  "audit",
                  "lint",
                  "card",
                  "theme",
                  "review"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "plannedChecks": {
          "type": "array",
          "minItems": 1,
          "description": "Automated checks a proposed rule is meant to get; not yet built, so the rule is reviewed meanwhile",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "blueprint",
                  "audit",
                  "lint",
                  "card",
                  "theme",
                  "journey",
                  "metrics",
                  "trace",
                  "guide",
                  "prototype"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "dependsOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
          },
          "description": "Rules that must pass before this one is judged"
        },
        "takesPrecedenceOver": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
          },
          "description": "Rules this one wins over when they clash"
        },
        "heuristics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H([1-9]|10) "
          },
          "description": "Nielsen's usability heuristics the rule bears on"
        },
        "status": {
          "enum": [
            "proposed"
          ],
          "description": "proposed: not yet reviewed into the SDK's rules; reviewed by hand, plus whichever of its planned checks are built"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "licence",
        "wording"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "licence": {
          "enum": [
            "apple-terms",
            "google-terms",
            "microsoft-terms",
            "nngroup-terms",
            "CC-BY-2.5",
            "CC-BY-4.0",
            "CC-BY-NC-SA-4.0",
            "CC-BY-NC-ND-4.0",
            "W3C",
            "own",
            "OGL-3.0",
            "public-domain",
            "CC-BY-SA-2.5",
            "CC-BY-SA-4.0",
            "Apache-2.0",
            "publisher-terms"
          ]
        },
        "wording": {
          "enum": [
            "paraphrased",
            "quoted"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ]
    }
  }
}
