{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "ux-builder interaction rules (CONTRACT-005)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$description": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compactDestinations",
        "lineLength"
      ],
      "properties": {
        "compactDestinations": {
          "type": "integer",
          "minimum": 1
        },
        "lineLength": {
          "type": "integer",
          "minimum": 20
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "rationale",
        "checks",
        "severity",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "context": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "app",
                  "view"
                ]
              }
            },
            "sizeClass": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "compact",
                  "medium",
                  "expanded",
                  "large",
                  "extra-large"
                ]
              }
            },
            "input": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "coarse",
                  "fine"
                ]
              }
            },
            "aiRole": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "generative",
                  "assistant",
                  "agent"
                ]
              }
            }
          }
        },
        "appliesTo": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "widgets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "blueprint",
                  "audit",
                  "lint",
                  "card",
                  "review"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "licence",
        "wording"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "licence": {
          "enum": [
            "apple-terms",
            "google-terms",
            "microsoft-terms",
            "CC-BY-2.5",
            "CC-BY-4.0",
            "CC-BY-NC-SA-4.0",
            "CC-BY-NC-ND-4.0",
            "W3C",
            "own"
          ]
        },
        "wording": {
          "enum": [
            "paraphrased",
            "quoted"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
