{
  "name": "@ux-builder/tokens",
  "version": "1.7.0",
  "license": "MIT OR Apache-2.0",
  "description": "Design tokens for the harness and embedded products: one CSS block per brand and per design system, composed in the browser, and every combination's resolved values, and the open-licensed fonts the themes use.",
  "type": "module",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    "./brands/*.css": "./dist/brands/*.css",
    "./design-systems/*.css": "./dist/design-systems/*.css",
    "./themes.css": "./dist/themes.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./bridges/*": "./dist/bridges/*",
    "./resolved/*.json": "./dist/resolved/*.json",
    "./manifest.json": "./dist/manifest.json",
    "./brand/*": "./dist/brand/*",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocumentDrivenDX/ux-builder.git",
    "directory": "packages/tokens"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@playwright/test": "^1.63.0"
  }
}
