{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-builder.dev/schema/backlog.schema.json",
  "title": "ux-builder assessment record: backlog (CONTRACT-006)",
  "type": "object",
  "required": [
    "schema",
    "version",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "backlog"
    },
    "version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "run_id",
          "title",
          "finding_type",
          "journey_id",
          "state_id",
          "role",
          "source_refs",
          "test_refs",
          "evidence_refs",
          "observed_behavior",
          "expected_behavior_or_proposed_requirement",
          "recommendation",
          "component_mapping",
          "priority",
          "confidence",
          "effort",
          "dependencies",
          "verification",
          "proposed_doc_changes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-"
          },
          "rule": {
            "description": "The interaction rule or heuristic the finding is about (CONTRACT-005 rule id); required for a finding of an AI journey, from that journey's plan.json ai.heuristics (FEAT-011 AIX-03)",
            "type": "string",
            "minLength": 1
          },
          "finding_type": {
            "enum": [
              "deterministic",
              "observed",
              "heuristic",
              "sdk-adoption",
              "real-user"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "type": "object",
            "required": [
              "level",
              "reason"
            ],
            "properties": {
              "level": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "effort": {
            "enum": [
              "S",
              "M",
              "L",
              "unknown"
            ]
          },
          "status": {
            "enum": [
              "open",
              "accepted",
              "rejected",
              "deferred"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "component_mapping": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind",
                "version",
                "catalogue_ref",
                "work"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "pattern",
                    "widget"
                  ]
                },
                "work": {
                  "enum": [
                    "composition",
                    "custom-gap",
                    "sdk-defect"
                  ]
                }
              }
            }
          },
          "qualified": {
            "type": "array",
            "items": {
              "enum": [
                "alignment"
              ]
            }
          },
          "uncertainty": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "validation_work": {
            "type": "boolean"
          },
          "usage": {
            "type": "string"
          },
          "plain": {
            "description": "The finding in plain English for a product or technical leader (FEAT-013 ANN-03): one or two sentences each, no rule ID, token or component name.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "problem",
              "recommendation"
            ],
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "elements": {
            "description": "Selectors of the elements the finding is about, outlined in walkthrough videos (FEAT-013 ANN-01).",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "user_validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "why"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      }
    }
  }
}
