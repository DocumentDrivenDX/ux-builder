{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-builder.dev/schema/walkthrough.schema.json",
  "title": "ux-builder assessment record: walkthrough (CONTRACT-006)",
  "type": "object",
  "required": [
    "schema",
    "version",
    "journeys"
  ],
  "properties": {
    "schema": {
      "const": "walkthrough"
    },
    "version": {
      "const": 1
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^J-"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "blocked"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "n",
                "action",
                "status"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "screen": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The blueprint screen the step was on (FEAT-018 GDL-50: the screens the heuristic pass covers)"
                },
                "url": {
                  "type": "string"
                },
                "checkpoint": {
                  "type": "string",
                  "pattern": "^C-"
                },
                "status": {
                  "enum": [
                    "done",
                    "blocked",
                    "not-assessed"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "judgment": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "success",
                    "empty",
                    "loading",
                    "recoverable-error",
                    "system-failure",
                    "ai",
                    "responsive-keyboard"
                  ]
                },
                "observation": {
                  "type": "object",
                  "required": [
                    "text",
                    "basis"
                  ],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "screenshot",
                          "tree",
                          "dom-text"
                        ]
                      }
                    },
                    "visual": {
                      "type": "boolean"
                    }
                  }
                },
                "do": {
                  "description": "The replay step the agent took (CONTRACT-006 Walkthrough videos; the inspect --replay format). A secret value is { secret: NAME }, never a literal.",
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "goto"
                      ],
                      "properties": {
                        "goto": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "enum": [
                            "create-test-data",
                            "edit-test-data",
                            "delete-test-data",
                            "payment",
                            "send-message",
                            "production-approval",
                            "delete-real-data"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "click"
                      ],
                      "properties": {
                        "click": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "enum": [
                            "create-test-data",
                            "edit-test-data",
                            "delete-test-data",
                            "payment",
                            "send-message",
                            "production-approval",
                            "delete-real-data"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "fill",
                        "value"
                      ],
                      "properties": {
                        "fill": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "enum": [
                            "create-test-data",
                            "edit-test-data",
                            "delete-test-data",
                            "payment",
                            "send-message",
                            "production-approval",
                            "delete-real-data"
                          ]
                        },
                        "value": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "secret"
                              ],
                              "properties": {
                                "secret": {
                                  "type": "string",
                                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "press"
                      ],
                      "properties": {
                        "press": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "enum": [
                            "create-test-data",
                            "edit-test-data",
                            "delete-test-data",
                            "payment",
                            "send-message",
                            "production-approval",
                            "delete-real-data"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "waitFor"
                      ],
                      "properties": {
                        "waitFor": {
                          "type": "string",
                          "minLength": 1
                        },
                        "action": {
                          "enum": [
                            "create-test-data",
                            "edit-test-data",
                            "delete-test-data",
                            "payment",
                            "send-message",
                            "production-approval",
                            "delete-real-data"
                          ]
                        }
                      }
                    }
                  ]
                },
                "alternate": {
                  "description": "The blueprint alternate (plan.json alternates[].n) this step belongs to; absent for the main path.",
                  "type": "integer",
                  "minimum": 1
                },
                "at": {
                  "type": "string",
                  "description": "When the step was taken (ISO 8601), for time per step (FEAT-018 GDL-52)"
                },
                "failed": {
                  "type": "boolean",
                  "description": "The action did not do what the agent expected (FEAT-018 GDL-52)"
                },
                "notFound": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Information the agent looked for here and did not find (FEAT-018 GDL-52)"
                },
                "error": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An interface error the screen showed (FEAT-018 GDL-52)"
                }
              }
            }
          }
        }
      }
    }
  }
}
