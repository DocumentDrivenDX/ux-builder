{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-builder.dev/schema/assessment-manifest.schema.json",
  "title": "ux-builder UX assessment manifest (CONTRACT-006)",
  "description": "ux-assessment.yml: binds the app's HELIX marker, flow and catalogue, and says how to run the app, which journeys to assess, which tests describe it, and what the assessment may do. It never copies HELIX requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "app", "run", "roles", "journeys", "restrictions"],
  "$defs": {
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "inputs": { "description": "What the scenario types or asks: a string, a list or a mapping" },
        "step": { "description": "risky: the high-impact step, as a 1-based walkthrough step number or the action's label", "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "string", "minLength": 1 }] }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "app": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "repository": { "type": "string" } }
    },
    "blueprint": { "type": "string", "minLength": 1, "description": "The app's blueprint (CONTRACT-005), where journeys[].blueprint is resolved. Default: app.blueprint.json beside the manifest" },
    "helix": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "marker": { "type": "string", "minLength": 1 },
        "flow": { "type": "string", "minLength": 1 },
        "catalog": { "type": "string", "minLength": 1 },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["baseUrl", "environment"],
      "properties": {
        "cwd": { "type": "string" },
        "start": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "minLength": 1 },
        "ready": {
          "type": "object", "additionalProperties": false, "required": ["url"],
          "properties": { "url": { "type": "string" }, "status": { "type": "integer" }, "timeoutMs": { "type": "integer", "minimum": 1000 } }
        },
        "environment": { "type": "string" },
        "origins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "auth": {
            "oneOf": [
              { "const": "none" },
              { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } } },
              { "type": "object", "additionalProperties": false, "required": ["storageState"], "properties": { "storageState": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string" }, "setup": { "type": "string" }, "reset": { "type": "string" } } }
    },
    "journeys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["priority", "role"],
        "allOf": [
          { "if": { "required": ["blueprint"] }, "else": { "required": ["id", "story", "entry"] } },
          { "if": { "required": ["ai"], "properties": { "ai": { "const": true } } }, "then": { "required": ["scenarios"] } }
        ],
        "properties": {
          "id": { "type": "string" },
          "blueprint": { "type": "string", "pattern": "^J-[a-z0-9]+(-[a-z0-9]+)*$", "description": "A journey id in the app's blueprint: its story, criteria, entry and steps come from there, and the manifest gives none of them; id defaults to it (FEAT-012 ASM-01)" },
          "ai": { "type": "boolean", "description": "An AI journey: walked in three scenarios, with the AI rules for its roles as heuristics (FEAT-011 AIX-01, AIX-02)" },
          "scenarios": {
            "type": "object", "additionalProperties": false, "required": ["normal", "errorProne", "risky"],
            "properties": {
              "normal": { "$ref": "#/$defs/scenario" },
              "errorProne": { "$ref": "#/$defs/scenario" },
              "risky": { "$ref": "#/$defs/scenario" }
            }
          },
          "story": { "type": "string" },
          "criteria": { "type": "array", "items": { "type": "string" } },
          "priority": { "type": "string" },
          "role": { "type": "string" },
          "fixture": { "type": "string" },
          "entry": { "type": "string" },
          "states": { "type": "array", "items": { "enum": ["success", "empty", "loading", "recoverable-error", "system-failure", "ai", "responsive-keyboard"] }, "uniqueItems": true },
          "notApplicable": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
          "tests": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string" }, "title": { "type": "string" } } } }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "report": { "type": "object", "additionalProperties": false, "required": ["format", "path"], "properties": { "format": { "enum": ["junit", "playwright-json", "node-tap"] }, "path": { "type": "string" } } },
          "timeoutMinutes": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "urls": { "type": "array", "items": { "type": "string" } },
        "widths": { "type": "array", "items": { "type": "integer", "minimum": 200, "maximum": 4000 } },
        "themes": { "type": "array", "items": { "type": "string" } },
        "appearances": { "type": "array", "items": { "enum": ["light", "dark"] } },
        "off": { "type": "array", "items": { "type": "string" } },
        "wait": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "out": { "type": "string" },
        "capture": { "enum": ["screenshot", "tree", "both"] },
        "redact": { "type": "object", "additionalProperties": false, "properties": { "selectors": { "type": "array", "items": { "type": "string" } }, "text": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": { "runMinutes": { "type": "number", "exclusiveMinimum": 0 }, "steps": { "type": "integer", "minimum": 1 }, "journeyMinutes": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "restrictions": {
      "type": "object", "additionalProperties": false, "required": ["writes"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } },
        "excludeIntegrations": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "string" }
      }
    }
  }
}
