{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-builder.dev/schema/annotations.schema.json",
  "title": "ux-builder assessment record: a walkthrough video's annotation timeline (CONTRACT-006 Walkthrough videos)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "journey",
    "viewport",
    "chapters",
    "annotations"
  ],
  "properties": {
    "schema": {
      "const": "annotations"
    },
    "version": {
      "const": 1
    },
    "journey": {
      "type": "string",
      "pattern": "^(J-)?[a-z]"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "start",
          "end",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "title",
              "main",
              "alternate",
              "end"
            ]
          },
          "alternate": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "enum": [
              "recorded",
              "stopped"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "checkpoint",
          "chapter",
          "start",
          "end",
          "kind",
          "priority",
          "boxes",
          "caption"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "pattern": "^F-"
          },
          "checkpoint": {
            "type": "string",
            "pattern": "^C-"
          },
          "chapter": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "checked",
              "judgment"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              }
            }
          },
          "caption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "problem",
              "recommendation"
            ],
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "hold": {
            "type": "number",
            "minimum": 0,
            "description": "The seconds the finding is held at the video's pace (FEAT-015 RPT-06)"
          },
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "description": "The rule the finding breaks (ID and full statement), or its heuristic and source (FEAT-015 RPT-07)",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "heuristic": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "id",
                  "statement"
                ]
              },
              {
                "required": [
                  "heuristic"
                ]
              }
            ]
          }
        }
      }
    },
    "pace": {
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "description": "The pace the video was rendered at (FEAT-015 RPT-06; assess video --pace)"
    },
    "steps": {
      "type": "array",
      "description": "Each replayed step as a chapter of its own, in order (FEAT-015 RPT-07)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "chapter",
          "title",
          "start",
          "end"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "chapter": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "\"<journey> · step <n>: <screen>\" (FEAT-015 RPT-07)"
          },
          "screen": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
