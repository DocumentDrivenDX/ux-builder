{
  "$description": "The components an agent may render in a conversation (FEAT-007 GEN-01; FEAT-011 AIB-03; CONTRACT-004 Assistant and generative UI), each with the JSON Schema its props must pass. tools/gen-catalogue.mjs marks these renderable in catalogue.json and fails if one is not in the catalogue; GenerativeComponent renders nothing else. Props are JSON only: no functions, no markup.",
  "components": {
    "DataTable": {
      "type": "object",
      "required": ["columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "required": ["key", "label"], "additionalProperties": false,
            "properties": { "key": { "type": "string", "maxLength": 64 }, "label": { "type": "string", "maxLength": 120 }, "numeric": { "type": "boolean" }, "sortable": { "type": "boolean" } }
          }
        },
        "rows": {
          "type": "array", "maxItems": 1000,
          "items": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"], "maxLength": 2000 } }
        },
        "rowKey": { "type": "string", "maxLength": 64 },
        "caption": { "type": "string", "maxLength": 200 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "Card": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string", "maxLength": 200 }, "body": { "type": "string", "maxLength": 4000 } }
    },
    "Notice": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": { "tone": { "enum": ["info", "accent", "success", "warning", "error"] }, "title": { "type": "string", "maxLength": 200 }, "body": { "type": "string", "maxLength": 2000 } }
    },
    "StatusPill": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": { "state": { "enum": ["live", "limited", "purchasing", "evaluation", "closed"] }, "label": { "type": "string", "maxLength": 60 } }
    },
    "ProgressBar": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string", "maxLength": 200 }, "value": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 }, "showValue": { "type": "boolean" } }
    },
    "DescriptionList": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": { "type": "object", "required": ["label", "value"], "additionalProperties": false, "properties": { "label": { "type": "string", "maxLength": 120 }, "value": { "type": ["string", "number"], "maxLength": 2000 }, "wide": { "type": "boolean" } } }
        }
      }
    },
    "StatTile": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 120 },
        "value": { "type": ["string", "number"], "maxLength": 60 },
        "change": { "type": "object", "required": ["direction"], "additionalProperties": false, "properties": { "direction": { "enum": ["up", "down", "flat"] }, "amount": { "type": "string", "maxLength": 30 }, "comparison": { "type": "string", "maxLength": 60 } } }
      }
    },
    "InlineForm": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "submitLabel": { "type": "string", "maxLength": 60 },
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["name", "label"], "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "maxLength": 64 },
              "label": { "type": "string", "maxLength": 120 },
              "type": { "enum": ["text", "number", "date", "select", "checkbox"] },
              "options": { "type": "array", "maxItems": 50, "items": { "type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": { "value": { "type": "string", "maxLength": 120 }, "label": { "type": "string", "maxLength": 120 } } } },
              "value": { "type": ["string", "number", "boolean"], "maxLength": 2000 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "Wizard": {
      "type": "object",
      "required": ["title", "steps"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "submitLabel": { "type": "string", "maxLength": 60 },
        "steps": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "required": ["id", "title", "fields"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 64 },
              "title": { "type": "string", "maxLength": 120 },
              "fields": { "type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "required": ["name", "label"], "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 64}, "label": {"type": "string", "maxLength": 120}, "type": {"enum": ["text", "number", "date", "select", "checkbox"]}, "options": {"type": "array", "maxItems": 50, "items": {"type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": {"value": {"type": "string", "maxLength": 120}, "label": {"type": "string", "maxLength": 120}}}}, "value": {"type": ["string", "number", "boolean"], "maxLength": 2000}, "required": {"type": "boolean"}}} }
            }
          }
        }
      }
    },
    "FormPage": {
      "type": "object",
      "required": ["title", "sections"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "submitLabel": { "type": "string", "maxLength": 60 },
        "sections": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "required": ["title", "fields"], "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "maxLength": 120 },
              "fields": { "type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "required": ["name", "label"], "additionalProperties": false, "properties": {"name": {"type": "string", "maxLength": 64}, "label": {"type": "string", "maxLength": 120}, "type": {"enum": ["text", "number", "date", "select", "checkbox"]}, "options": {"type": "array", "maxItems": 50, "items": {"type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": {"value": {"type": "string", "maxLength": 120}, "label": {"type": "string", "maxLength": 120}}}}, "value": {"type": ["string", "number", "boolean"], "maxLength": 2000}, "required": {"type": "boolean"}}} }
            }
          }
        }
      }
    }
  }
}
