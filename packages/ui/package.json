{
  "name": "@ux-builder/ui",
  "version": "0.11.0",
  "license": "MIT OR Apache-2.0",
  "description": "Widgets for the harness and embedded products: prefixed CSS and React 19 components on @ux-builder/tokens, shaped by whichever theme is on.",
  "type": "module",
  "bin": {
    "ux-builder-blueprint": "blueprint/cli.mjs"
  },
  "files": [
    "dist",
    "licenses",
    "lint",
    "blueprint",
    "adaptive-cards",
    "catalogue.json",
    "AGENTS.md",
    "skill",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./icons": "./dist/icons.js",
    "./patterns": "./dist/patterns.js",
    "./assistant": "./dist/assistant.js",
    "./assistant/ai-sdk": "./dist/assistant-ai-sdk.js",
    "./assistant/assistant-ui": "./dist/assistant-assistant-ui.js",
    "./adaptive-cards": "./dist/adaptive-cards.js",
    "./adaptive-cards/check": "./adaptive-cards/check.mjs",
    "./ui.css": "./dist/ui.css",
    "./patterns.css": "./dist/patterns.css",
    "./stylelint": "./lint/stylelint.mjs",
    "./eslint": "./lint/eslint.mjs",
    "./blueprint": "./blueprint/index.mjs",
    "./blueprint/modalities": "./blueprint/modalities.mjs",
    "./blueprint/prototype": "./blueprint/prototype.mjs",
    "./blueprint/propose": "./blueprint/propose.mjs",
    "./blueprint/paths": "./blueprint/paths.mjs",
    "./catalogue.json": "./catalogue.json",
    "./AGENTS.md": "./AGENTS.md",
    "./skill/*": "./skill/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/gen-icons.mjs --library && vite build && cp src/ui.css dist/ui.css && cp src/patterns.css dist/patterns.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:storybook": "node --test 'test/storybook/*.test.mjs'",
    "prepublishOnly": "npm run build",
    "test": "node --test 'test/*.test.mjs'",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@ux-builder/tokens": "^1.6.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.15 <0.16",
    "ai": ">=5 <8",
    "eslint": ">=9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stylelint": ">=16"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.29",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@carbon/icons": "^11.89.0",
    "@fluentui/svg-icons": "^1.1.343",
    "@material-symbols/svg-400": "^0.47.6",
    "@playwright/test": "~1.63.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.145",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.59.0",
    "lucide-static": "^1.52.0",
    "motion": "^14.4.0",
    "nanoid": "^3.3.19",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "storybook": "^10.6.1",
    "streamdown": "^2.7.1",
    "stylelint": "^17.16.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocumentDrivenDX/ux-builder.git",
    "directory": "packages/ui"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
