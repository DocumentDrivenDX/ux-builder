{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentdrivendx.github.io/ux-builder/schema/design-output.schema.json",
  "title": "ux-builder-design --json output (CONTRACT-008 Commands)",
  "description": "What each command prints with --json; its exported function returns the same object.",
  "$defs": {
    "applyImpact": {
      "type": "object",
      "required": [
        "applied",
        "change",
        "errors",
        "delta",
        "regenerated",
        "summary"
      ]
    },
    "baseline": {
      "type": "object",
      "required": [
        "written",
        "run",
        "screens",
        "journeys",
        "stories",
        "findings",
        "drafted"
      ],
      "properties": {
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "drafted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "brief": {
      "type": "object",
      "required": [
        "written",
        "sections",
        "notes",
        "helix"
      ],
      "properties": {
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "heading",
              "points"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "helix": {
          "type": "boolean"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "checkpoint",
        "about",
        "trace"
      ],
      "properties": {
        "checkpoint": {
          "type": "object",
          "required": [
            "id",
            "status",
            "at"
          ]
        },
        "about": {
          "type": "string"
        },
        "trace": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "decisionAdd": {
      "type": "object",
      "required": [
        "id",
        "path",
        "proposal",
        "status",
        "trace"
      ]
    },
    "decisionStatus": {
      "type": "object",
      "required": [
        "id",
        "path",
        "proposal",
        "status",
        "evidence",
        "date",
        "history"
      ]
    },
    "diagnose": {
      "type": "object",
      "required": [
        "id",
        "insight",
        "observation",
        "explanations",
        "hypothesis",
        "alternative",
        "path"
      ],
      "properties": {
        "explanations": {
          "type": "array",
          "minItems": 2
        }
      }
    },
    "evidenceAdd": {
      "type": "object",
      "required": [
        "id",
        "path",
        "kind",
        "date",
        "source",
        "file"
      ]
    },
    "evidenceList": {
      "type": "object",
      "required": [
        "evidence"
      ],
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "date",
              "source",
              "excerpts",
              "path"
            ]
          }
        }
      }
    },
    "excerptAdd": {
      "type": "object",
      "required": [
        "id",
        "path",
        "participant",
        "excerpt"
      ]
    },
    "experimentEnd": {
      "type": "object",
      "required": [
        "id",
        "status",
        "metric",
        "control",
        "variant",
        "improved",
        "guardrails",
        "hypothesis",
        "supported",
        "result",
        "next"
      ],
      "properties": {
        "status": {
          "const": "ended"
        }
      }
    },
    "experimentStart": {
      "type": "object",
      "required": [
        "id",
        "bead",
        "status",
        "decision",
        "variant",
        "metric",
        "guardrails",
        "duration",
        "hypothesis",
        "stopping"
      ],
      "properties": {
        "status": {
          "const": "running"
        }
      }
    },
    "explain": {
      "type": "object",
      "required": [
        "terms"
      ],
      "properties": {
        "step": {
          "type": "integer"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "step",
              "means",
              "why"
            ]
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "change",
        "mode",
        "matched",
        "affected",
        "decisions"
      ],
      "properties": {
        "checkpointRequired": {
          "const": "significant-change"
        }
      }
    },
    "init": {
      "type": "object",
      "required": [
        "app",
        "startedFrom",
        "blueprint",
        "sdk",
        "mcp",
        "written",
        "notes"
      ],
      "properties": {
        "app": {
          "type": "string"
        },
        "startedFrom": {
          "enum": [
            "new",
            "existing"
          ]
        },
        "blueprint": {
          "enum": [
            "exists",
            "written"
          ]
        },
        "sdk": {
          "type": "boolean"
        },
        "mcp": {
          "type": "boolean"
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "insights": {
      "type": "object",
      "required": [
        "id",
        "date",
        "events",
        "journeys",
        "unmatched",
        "path"
      ]
    },
    "migrate": {
      "type": "object",
      "required": [
        "migrated",
        "moves",
        "updated",
        "git"
      ],
      "properties": {
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ]
          }
        }
      }
    },
    "modality": {
      "type": "object",
      "required": [
        "file",
        "modalities",
        "sizeClasses",
        "answer",
        "at"
      ]
    },
    "mode": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "change"
          ]
        },
        "why": {
          "type": "string"
        }
      }
    },
    "observeImport": {
      "type": "object",
      "required": [
        "kit",
        "path",
        "imported",
        "findings",
        "skipped",
        "sessions"
      ]
    },
    "overview": {
      "type": "object",
      "required": [
        "steps",
        "change",
        "review"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "n",
              "name",
              "activity",
              "you",
              "produces",
              "terms"
            ]
          }
        },
        "change": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "review": {
          "type": "string"
        }
      }
    },
    "ready": {
      "type": "object",
      "required": [
        "for",
        "checks",
        "ready",
        "next"
      ]
    },
    "report": {
      "type": "object",
      "required": [
        "id",
        "path",
        "follows",
        "approach",
        "contradicted",
        "assumptions",
        "observed",
        "findings"
      ]
    },
    "reviewApprove": {
      "type": "object",
      "required": [
        "item",
        "approved",
        "remaining",
        "next"
      ]
    },
    "reviewFeedback": {
      "type": "object",
      "required": [
        "id",
        "item",
        "text",
        "status",
        "at"
      ]
    },
    "reviewList": {
      "type": "object",
      "required": [
        "pending",
        "count",
        "next"
      ],
      "properties": {
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "step",
              "title",
              "file",
              "hash",
              "changed",
              "feedback"
            ]
          }
        },
        "count": {
          "type": "integer"
        },
        "next": {
          "type": "string"
        }
      }
    },
    "reviewRespond": {
      "type": "object",
      "required": [
        "id",
        "item",
        "text",
        "status",
        "response"
      ],
      "properties": {
        "status": {
          "const": "addressed"
        }
      }
    },
    "reviewShow": {
      "type": "object",
      "required": [
        "id",
        "step",
        "title",
        "file",
        "content",
        "hash",
        "status",
        "feedback"
      ]
    },
    "route": {
      "type": "object",
      "required": [
        "findings",
        "target",
        "patch"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "path",
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "existing",
                "new"
              ]
            }
          }
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "alternative",
        "file",
        "dimensions",
        "recommendable"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "overall"
            ]
          },
          {
            "required": [
              "average"
            ]
          },
          {
            "required": [
              "total"
            ]
          },
          {
            "required": [
              "score"
            ]
          }
        ]
      },
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseline",
              "predicted",
              "observed"
            ],
            "properties": {
              "predicted": {
                "type": "object",
                "required": [
                  "value",
                  "basis"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "computed",
                      "judgment",
                      "to validate"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "stateGet": {
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "stateSet": {
      "type": "object",
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "activity",
        "mode",
        "startedFrom",
        "chosen",
        "untestedAssumptions",
        "openQuestions",
        "checkpoints",
        "openIssues",
        "runningExperiments",
        "next",
        "documents",
        "text",
        "jobs",
        "prototype",
        "progress",
        "awaitingReview"
      ],
      "properties": {
        "activity": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ]
        },
        "untestedAssumptions": {
          "type": "integer"
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ]
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "id"
            ]
          }
        },
        "text": {
          "type": "string"
        },
        "progress": {
          "type": "object",
          "required": [
            "mode",
            "step",
            "of",
            "name",
            "text"
          ],
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 0
            },
            "of": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "awaitingReview": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "mode",
        "step",
        "of",
        "name",
        "text"
      ]
    },
    "testKit": {
      "type": "object",
      "required": [
        "id",
        "dir",
        "tasks",
        "written",
        "users"
      ]
    },
    "trace": {
      "type": "object",
      "required": [
        "item",
        "upstream",
        "downstream"
      ]
    },
    "transcriptAdd": {
      "type": "object",
      "required": [
        "session",
        "excerpts",
        "consent"
      ],
      "properties": {
        "consent": {
          "type": "object",
          "required": [
            "confirmed",
            "date"
          ]
        }
      }
    },
    "validate": {
      "type": "object",
      "required": [
        "documents",
        "problems",
        "warnings",
        "notes",
        "valid"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "type",
              "id"
            ]
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "message"
            ]
          }
        },
        "valid": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "message"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "message"
            ]
          }
        }
      }
    }
  }
}
