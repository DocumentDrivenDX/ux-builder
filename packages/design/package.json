    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ux-builder/audit": "^0.7.0",
    "@ux-builder/trace": "^0.2.0",
    "@ux-builder/ui": "^0.14.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocumentDrivenDX/ux-builder.git",
    "directory": "packages/design"
  }
}
