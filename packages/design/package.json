    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "app.mjs",
    "state.mjs",
    "status.mjs",
    "checkpoints.mjs",
    "init.mjs",
    "baseline.mjs",
    "brief.mjs",
    "research.mjs",
    "decisions.mjs",
    "rubric.mjs",
    "ready.mjs",
    "graph.mjs",
    "testkit.mjs",
    "sessions.mjs",
    "evaluation.mjs",
    "insights.mjs",
    "experiments.mjs",
    "process.mjs",
    "review.mjs",
    "modality.mjs",
    "migrate.mjs",
    "metrics.mjs",
    "intake.mjs",
    "advance.mjs",
    "proposals.mjs",
    "glossary.json",
    "documents.mjs",
    "cli.mjs",
    "artifacts",
    "schema",
    "skill",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
