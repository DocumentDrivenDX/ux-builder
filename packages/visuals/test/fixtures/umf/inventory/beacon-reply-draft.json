      },
      "sequence": {
        "participants": [
          {
            "id": "agent",
            "label": "Support agent",
            "role": "actor",
            "status": "built"
          },
          {
            "id": "proxy",
            "label": "Sign-in proxy",
            "detail": "checks identity, forwards the agent's token",
            "role": "platform",
            "status": "built"
          },
          {
            "id": "web",
            "label": "Web app",
            "detail": "the agent's inbox and draft editor",
            "role": "own",
            "status": "built"
          },
          {
            "id": "api",
            "label": "Beacon API",
            "detail": "every request runs as the agent",
            "role": "own",
            "status": "built"
          },
          {
            "id": "db",
            "label": "Beacon database",
            "detail": "tickets, drafts, reviews",
            "role": "store",
            "status": "built"
          },
          {
            "id": "drafter",
            "label": "Reply drafter",
            "detail": "builds the prompt from the ticket and its history",
            "role": "own",
            "status": "built"
          },
          {
            "id": "gateway",
            "label": "Model gateway",
            "detail": "rate limits, usage, model choice",
            "role": "platform",
            "status": "built"
          },
          {
            "id": "models",
            "label": "Language models",
            "role": "platform",
            "status": "built"
          }
        ],
        "messages": [
          {
            "id": "m1",
            "from": "agent",
            "to": "proxy",
            "label": "opens a ticket",
            "kind": "call"
          },
          {
            "id": "m2",
            "from": "proxy",
            "to": "web",
            "label": "forwards with the agent's token",
            "kind": "call"
          },
          {
            "id": "m3",
            "from": "web",
            "to": "api",
            "label": "asks for a draft",
            "kind": "call"
          },
          {
            "id": "m4",
            "from": "api",
            "to": "db",
            "label": "loads ticket history",
            "kind": "call"
          },
          {
            "id": "m5",
            "from": "api",
            "to": "drafter",
            "label": "hands over the ticket and its history",
            "kind": "call"
          },
          {
            "id": "m6",
            "from": "drafter",
            "to": "gateway",
            "label": "sends the prompt",
            "kind": "call"
          },
          {
            "id": "m7",
            "from": "gateway",
            "to": "models",
            "label": "routes to a model",
            "kind": "call"
          },
          {
            "id": "m8",
            "from": "api",
            "to": "web",
            "label": "returns the draft",
            "kind": "return"
          }
        ]
      },
